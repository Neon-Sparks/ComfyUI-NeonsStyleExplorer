","type":"COMBO","widget":{"name":"weight_dtype"},"link":null}],"outputs":[{"localized_name":"MODEL","name":"MODEL","type":"MODEL","links":[1244]}],"properties":{"cnr_id":"comfy-core","ver":"0.11.0","Node name for S&R":"UNETLoader","enableTabs":false,"hasSecondTab":false,"models":[{"directory":"diffusion_models","name":"anima-preview2.safetensors","url":"https://huggingface.co/circlestone-labs/Anima/resolve/main/split_files/diffusion_models/anima-preview2.safetensors"}],"secondTabOffset":80,"secondTabText":"Send Back","secondTabWidth":65,"tabWidth":65,"tabXOffset":10},"widgets_values":["Krea 2\\Turbo\\krea2TurboINT8_v10.safetensors","default"],"widgets_values_named":{"unet_name":"Krea 2\\Turbo\\krea2TurboINT8_v10.safetensors","weight_dtype":"default"}},{"id":384,"type":"Note","pos":[1604.019303810997,1483.0820677336703],"size":[620.9100000000003,682.04],"flags":{},"order":6,"mode":0,"inputs":[],"outputs":[],"properties":{},"widgets_values":["A simple workflow i put together to help you get started\n\nGuide for populating catalog:\n1. choose your promt (option to save the prompt you used in catalog options at the top)\n2. Choose your crawl Source (I recomend starting with main)\n3. choose your output format (natural Language or booru tags)\n4. make sure the crawl button is set to crawl through\n5. set auto gallary to first\n6. you can edit the name of your catalog and add new catalogs for different models in the catalog menu (i suggest using themodel name you used)\n\nyou can populate the catalog without using the crawl method by leaving auto gallery on first. if you set it to every it will show tiny thumbs you can pick from as the image you want to use. \nif auto gallery is off but you like a generation you can click save and it will add it to the catalog. \n\nto create custom styles click the ... menu at the bottom of the node or the new style option in the catalog. \n\n\nTIPS: \n1. when populating the catalog i suggest a basic promps like \"an adult woman with blond hair wearing a red hoodie and white shorts\" some of the styles will fight the prompt where the style is B&W. (experiment until you get the result youre looking for) \n2. you can set your run mode to run on change (little dropdown next to run button) and leave it running \n3. set you image size smaller to generate previews faster\n\nI hope you Enjoy this node. I have spent a lot of time vibe coding it and fixing issues at great expence. \n\nIf you have Instagram feel free to follow me https://www.instagram.com/talk_to_neon i would love to see your creations. \n\n\n\nNote! some styles might now work well with every model. You are able to edit the styles to help you get the look you like. \n\nnode shape is a bit awkward and due to be fixed in a future update. you might need to resize it to see bottom buttons"],"widgets_values_named":{"text":"A simple workflow i put together to help you get started\n\nGuide for populating catalog:\n1. choose your promt (option to save the prompt you used in catalog options at the top)\n2. Choose your crawl Source (I recomend starting with main)\n3. choose your output format (natural Language or booru tags)\n4. make sure the crawl button is set to crawl through\n5. set auto gallary to first\n6. you can edit the name of your catalog and add new catalogs for different models in the catalog menu (i suggest using themodel name you used)\n\nyou can populate the catalog without using the crawl method by leaving auto gallery on first. if you set it to every it will show tiny thumbs you can pick from as the image you want to use. \nif auto gallery is off but you like a generation you can click save and it will add it to the catalog. \n\nto create custom styles click the ... menu at the bottom of the node or the new style option in the catalog. \n\n\nTIPS: \n1. when populating the catalog i suggest a basic promps like \"an adult woman with blond hair wearing a red hoodie and white shorts\" some of the styles will fight the prompt where the style is B&W. (experiment until you get the result youre looking for) \n2. you can set your run mode to run on change (little dropdown next to run button) and leave it running \n3. set you image size smaller to generate previews faster\n\nI hope you Enjoy this node. I have spent a lot of time vibe coding it and fixing issues at great expence. \n\nIf you have Instagram feel free to follow me https://www.instagram.com/talk_to_neon i would love to see your creations. \n\n\n\nNote! some styles might now work well with every model. You are able to edit the styles to help you get the look you like. \n\nnode shape is a bit awkward and due to be fixed in a future update. you might need to resize it to see bottom buttons"},"color":"#432","bgcolor":"#653"},{"id":388,"type":"NeonsStyleExplorer","pos":[2249.797324759971,1497.9249400614335],"size":[430,1295],"flags":{},"order":5,"mode":0,"inputs":[{"localized_name":"prompt","name":"prompt","type":"STRING","widget":{"name":"prompt"},"link":null},{"localized_name":"quality","name":"quality","type":"STRING","widget":{"name":"quality"},"link":null},{"localized_name":"negative","name":"negative","type":"STRING","widget":{"name":"negative"},"link":null},{"localized_name":"style","name":"style","type":"COMBO","widget":{"name":"style"},"link":null},{"localized_name":"extra_style","name":"extra_style","type":"COMBO","widget":{"name":"extra_style"},"link":null},{"localized_name":"custom_style","name":"custom_style","type":"COMBO","widget":{"name":"custom_style"},"link":null},{"localized_name":"format","name":"format","type":"COMBO","widget":{"name":"format"},"link":null},{"localized_name":"finish","name":"finish","type":"COMBO","widget":{"name":"finish"},"link":null},{"localized_name":"output_format","name":"output_format","type":"COMBO","widget":{"name":"output_format"},"link":null},{"localized_name":"style_position","name":"style_position","type":"COMBO","widget":{"name":"style_position"},"link":null},{"localized_name":"close_with_medium"